{
	"name": "e-paper-services",
	"main": "src/worker.py",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"python_workers"
	],
	// https://developers.cloudflare.com/workers/configuration/cron-triggers/#via-cloudflareconfigts
	"triggers": {
		// UTC: https://crontab.guru/
		"crons": [
			"55 1 * * *",
			"10 2 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}